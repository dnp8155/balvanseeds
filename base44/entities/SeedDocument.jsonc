{
  "name": "SeedDocument",
  "type": "object",
  "properties": {
    "seed_variety_id": {
      "type": "string"
    },
    "document_title": {
      "type": "string"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "brochure",
        "cultivation_guide",
        "certificate",
        "product_sheet",
        "other"
      ]
    },
    "file_url": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "file_size": {
      "type": "string"
    },
    "display_order": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft"
    }
  },
  "required": [
    "seed_variety_id",
    "document_title",
    "document_type",
    "file_url"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "published"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}