{
  "name": "SeedImage",
  "type": "object",
  "properties": {
    "seed_variety_id": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "alt_text": {
      "type": "string"
    },
    "caption": {
      "type": "string"
    },
    "image_type": {
      "type": "string",
      "enum": [
        "product",
        "field",
        "packaging",
        "farmer_result",
        "other"
      ]
    },
    "display_order": {
      "type": "number"
    },
    "is_cover": {
      "type": "boolean"
    }
  },
  "required": [
    "seed_variety_id",
    "image_url"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}