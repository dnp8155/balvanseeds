{
  "name": "DistributorApplication",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "business_name": {
      "type": "string"
    },
    "mobile": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "gst_number": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "district": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "existing_brands": {
      "type": "string"
    },
    "years_experience": {
      "type": "number"
    },
    "area_served": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "New",
        "Reviewing",
        "Approved",
        "Rejected"
      ],
      "default": "New"
    }
  },
  "required": [
    "full_name",
    "mobile",
    "state",
    "district"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}