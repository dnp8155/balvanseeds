{
  "name": "ExpertQuery",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "mobile": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "district": {
      "type": "string"
    },
    "crop": {
      "type": "string"
    },
    "selected_seed": {
      "type": "string"
    },
    "question": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "New",
        "Answered",
        "Closed"
      ],
      "default": "New"
    }
  },
  "required": [
    "name",
    "mobile",
    "question"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}