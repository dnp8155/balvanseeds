{
  "name": "Enquiry",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "district": {
      "type": "string"
    },
    "enquiry_type": {
      "type": "string",
      "enum": [
        "Farmer",
        "Dealer",
        "Distributor",
        "Business Partner",
        "General Enquiry"
      ]
    },
    "product_interest": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "source_page": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "New",
        "Contacted",
        "Qualified",
        "Closed"
      ],
      "default": "New"
    }
  },
  "required": [
    "name",
    "phone",
    "enquiry_type"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}